{
  "name": "logweir-console",
  "private": true,
  "version": "0.0.0-prototype",
  "description": "The Logweir console (PROD-18.1), served by logweir-api at /ui/.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "gen:api": "openapi-typescript ../schemas/logweir-api-v1.openapi.json --default-non-nullable false -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../schemas/logweir-api-v1.openapi.json --default-non-nullable false -o src/api/schema.d.ts --check",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "check:dist": "node scripts/check-dist.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@patternfly/react-core": "6.6.1",
    "@patternfly/react-icons": "6.6.1",
    "@patternfly/react-table": "6.6.1",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.14.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
