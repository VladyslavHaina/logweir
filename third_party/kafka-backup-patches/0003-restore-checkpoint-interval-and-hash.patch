+/// Write the restore checkpoint to `path` when at least `interval_secs` have
+/// passed since it was last saved (`0` saves on every call). Returns whether it
+/// wrote. This is what makes `restore.checkpoint_interval_secs` take effect
+/// inside a topic; without it the checkpoint is saved only after each topic.
+pub async fn save_checkpoint_if_due(
+    checkpoint: &Mutex<Option<RestoreCheckpoint>>,
+    path: &std::path::Path,
+    interval_secs: u64,
+) -> Result<bool> {
+    let mut cp = checkpoint.lock().await;
+    let Some(c) = cp.as_mut() else {
+        return Ok(false);
+    };
+    let interval_ms = i64::try_from(interval_secs.saturating_mul(1000)).unwrap_or(i64::MAX);
+    let now = chrono::Utc::now().timestamp_millis();
+    if now.saturating_sub(c.last_checkpoint_time) < interval_ms {
+        return Ok(false);
+    }
+    c.touch();
+    let json = serde_json::to_string_pretty(c)?;
+    tokio::fs::write(path, json).await?;
+    Ok(true)
+}
