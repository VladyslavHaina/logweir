+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ProducerIdentity {
+    pub producer_id: i64,
+    pub producer_epoch: i16,
+    pub base_sequence: i32,
+}
+
+/// The sequence number `n` records after `base`: Kafka's sequence wraps from
+/// `i32::MAX` to 0.
+pub fn sequence_after(base: i32, n: usize) -> i32 {
+    ((i64::from(base) + n as i64) % (i64::from(i32::MAX) + 1)) as i32
+}
+
+/// One idempotent producer for a restore (Logweir patch 0005, PROD-00.3d): one
+/// `InitProducerId` without a transactional id, and per partition the next
+/// sequence number, which advances only when a produce is acknowledged. A
+/// re-send therefore carries the sequence it carried before, and the broker
+/// discards it as a duplicate instead of appending a second copy. The restore
+/// writes each partition from one task at a time, so one request per partition
+/// is in flight.
+#[derive(Debug)]
+pub struct IdempotentProducer {
+    producer_id: i64,
+    producer_epoch: i16,
+    next_sequence: std::sync::Mutex<std::collections::HashMap<(String, i32), i32>>,
+}
+
+impl IdempotentProducer {
+    pub fn new(producer_id: i64, producer_epoch: i16) -> Self {
+        Self {
+            producer_id,
+            producer_epoch,
+            next_sequence: Default::default(),
+        }
+    }
+
+    /// The identity of the next batch for `topic`/`partition`.
+    pub fn identity(&self, topic: &str, partition: i32) -> ProducerIdentity {
+        let next = self.next_sequence.lock().expect("sequence lock");
+        ProducerIdentity {
+            producer_id: self.producer_id,
+            producer_epoch: self.producer_epoch,
+            base_sequence: next
+                .get(&(topic.to_string(), partition))
+                .copied()
+                .unwrap_or(0),
+        }
+    }
+
+    /// `records` records were acknowledged on `topic`/`partition`.
+    pub fn acknowledged(&self, topic: &str, partition: i32, records: usize) {
+        let mut next = self.next_sequence.lock().expect("sequence lock");
+        let seq = next.entry((topic.to_string(), partition)).or_insert(0);
+        *seq = sequence_after(*seq, records);
+    }
+}
+
+/// `InitProducerId` without a transactional id: any broker answers it.
+/// Retried a few times, as a fresh cluster can answer that it is not ready.
+pub async fn init_idempotent_producer(client: &KafkaClient) -> Result<IdempotentProducer> {
+    const ATTEMPTS: u32 = 5;
+    let mut attempt = 0;
+    loop {
+        attempt += 1;
+        let request = InitProducerIdRequest::default()
+            .with_transactional_id(None)
+            .with_transaction_timeout_ms(i32::MAX)
+            .with_producer_id(ProducerId(-1))
+            .with_producer_epoch(-1);
+        let response: InitProducerIdResponse =
+            client.send_request(ApiKey::InitProducerId, request).await?;
+        if response.error_code == 0 {
+            debug!(
+                "idempotent producer id {} epoch {}",
+                response.producer_id.0, response.producer_epoch
+            );
+            return Ok(IdempotentProducer::new(
+                response.producer_id.0,
+                response.producer_epoch,
+            ));
+        }
+        if attempt >= ATTEMPTS {
+            return Err(KafkaError::BrokerError {
+                code: response.error_code,
+                message: format!("InitProducerId failed: code {}", response.error_code),
+            }
+            .into());
+        }
+        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+    }
+}
