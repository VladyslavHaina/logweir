+    #[tokio::test]
+    async fn test_manifest_persistence_keeps_every_topics_replication_factor() {
+        let storage: Arc<dyn StorageBackend> = Arc::new(crate::storage::MemoryBackend::new());
+        let manifest = Arc::new(Mutex::new(BackupManifest::new("backup-1".to_string())));
+        {
+            let mut m = manifest.lock().await;
+            m.get_or_create_topic("orders");
+            m.get_or_create_topic("payments");
+        }
+        let persistence = ManifestPersistence::new(
+            "backup-1".to_string(),
+            storage.clone(),
+            manifest.clone(),
+            Duration::from_secs(30),
+        );
+        for (topic, factor) in [("orders", 3), ("payments", 2)] {
+            {
+                let mut m = manifest.lock().await;
+                let entry = m.get_or_create_topic(topic);
+                entry.original_partition_count = Some(1);
+                entry.source_replication_factor = Some(factor);
+            }
+            persistence.save_now().await.unwrap();
+        }
+
+        let data = storage.get("backup-1/manifest.json").await.unwrap();
+        let stored: BackupManifest = serde_json::from_slice(&data).unwrap();
+        let factor = |name: &str| {
+            stored
+                .topics
+                .iter()
+                .find(|t| t.name == name)
+                .and_then(|t| t.source_replication_factor)
+        };
+        assert_eq!(factor("orders"), Some(3));
+        assert_eq!(factor("payments"), Some(2));
+    }
