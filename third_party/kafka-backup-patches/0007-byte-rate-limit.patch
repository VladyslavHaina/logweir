+/// `restore.rate_limit_bytes_per_sec` (Logweir patch 0007, PROD-00.3h, C12):
+/// one limit on the WHOLE restore, shared by every partition task. Each batch
+/// reserves its key and value bytes on one next-allowed instant before it is
+/// produced and waits for its turn, so the restore's byte rate stays at the
+/// limit however many partitions write at once. `None` limits nothing.
+#[derive(Debug)]
+pub(crate) struct ByteRateLimiter {
+    bytes_per_sec: Option<u64>,
+    next_allowed: Mutex<Option<tokio::time::Instant>>,
+}
+
+impl ByteRateLimiter {
+    pub(crate) fn new(bytes_per_sec: Option<u64>) -> Self {
+        Self {
+            bytes_per_sec,
+            next_allowed: Mutex::new(None),
+        }
+    }
+
+    /// Wait until `bytes` may be produced.
+    pub(crate) async fn reserve(&self, bytes: u64) {
+        let Some(rate) = self.bytes_per_sec.filter(|r| *r > 0) else {
+            return;
+        };
+        let start = {
+            let mut next = self.next_allowed.lock().await;
+            let now = tokio::time::Instant::now();
+            let start = next.map_or(now, |n| n.max(now));
+            *next = Some(start + std::time::Duration::from_secs_f64(bytes as f64 / rate as f64));
+            start
+        };
+        tokio::time::sleep_until(start).await;
+    }
+}
+
+/// Key and value bytes of `records`, what `rate_limit_bytes_per_sec` counts.
+pub(crate) fn key_value_bytes(records: &[BackupRecord]) -> u64 {
+    records
+        .iter()
+        .map(|r| {
+            r.key.as_ref().map_or(0, |k| k.len()) as u64
+                + r.value.as_ref().map_or(0, |v| v.len()) as u64
+        })
+        .sum()
+}
+
 #[cfg(test)]
 mod tests {
     use super::*;
+
+    /// Two partition tasks share one limit: 10 batches of 1,000 bytes each at
+    /// 1,000 bytes/s take 9 s in all (the first goes at once), not 4.5 s as
+    /// two per-task limits would allow.
+    #[tokio::test(start_paused = true)]
+    async fn the_byte_rate_limit_paces_the_whole_restore() {
+        let limiter = std::sync::Arc::new(ByteRateLimiter::new(Some(1_000)));
+        let t0 = tokio::time::Instant::now();
+        let tasks: Vec<_> = (0..2)
+            .map(|_| {
+                let l = limiter.clone();
+                tokio::spawn(async move {
+                    for _ in 0..5 {
+                        l.reserve(1_000).await;
+                    }
+                })
+            })
+            .collect();
+        for t in tasks {
+            t.await.unwrap();
+        }
+        assert_eq!(t0.elapsed().as_secs(), 9);
+    }
+
+    #[tokio::test(start_paused = true)]
+    async fn no_byte_rate_limit_waits_for_nothing() {
+        let limiter = ByteRateLimiter::new(None);
+        let t0 = tokio::time::Instant::now();
+        for _ in 0..100 {
+            limiter.reserve(1 << 30).await;
+        }
+        assert_eq!(t0.elapsed(), std::time::Duration::ZERO);
+    }
     use crate::metrics::PerformanceMetrics;
     use crate::segment::{SegmentWriter, SegmentWriterConfig};
     use crate::storage::MemoryBackend;
