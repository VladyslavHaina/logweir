+    // ------------------------------------------------------------------
+    // Logweir patch 0004 (PROD-00.3a, C1): committed records only.
+    // ------------------------------------------------------------------
+
+    /// One batch of producer `pid`'s transactional records at `offsets`, or,
+    /// with `marker` (0 ABORT, 1 COMMIT), its control batch at `offsets[0]`.
+    fn txn_batch(pid: i64, offsets: &[i64], marker: Option<i16>) -> Vec<u8> {
+        let records: Vec<Record> = offsets
+            .iter()
+            .map(|&offset| {
+                let mut r = make_record(offset);
+                r.transactional = true;
+                r.producer_id = pid;
+                r.producer_epoch = 0;
+                if let Some(kind) = marker {
+                    r.control = true;
+                    let mut key = 0i16.to_be_bytes().to_vec();
+                    key.extend_from_slice(&kind.to_be_bytes());
+                    r.key = Some(Bytes::from(key));
+                    r.value = Some(Bytes::from_static(&[0, 0, 0, 0, 0, 0]));
+                }
+                r
+            })
+            .collect();
+        let mut buf = BytesMut::new();
+        RecordBatchEncoder::encode(
+            &mut buf,
+            records.iter(),
+            &RecordEncodeOptions {
+                version: 2,
+                compression: Compression::None,
+            },
+        )
+        .expect("encode failed");
+        buf.to_vec()
+    }
+
+    fn offsets_of(data: Vec<u8>, fetch_offset: i64, aborted: &[(i64, i64)]) -> (Vec<i64>, i64) {
+        let (records, next) =
+            decode_fetch_data(&Bytes::from(data), fetch_offset, aborted).expect("decode failed");
+        (records.iter().map(|r| r.offset).collect(), next)
+    }
+
+    #[test]
+    fn a_committed_transaction_is_kept_and_its_marker_skipped() {
+        let mut data = txn_batch(7, &[0, 1], None);
+        data.extend(txn_batch(7, &[2], Some(1)));
+        data.extend(encode_batch(&[3]));
+        assert_eq!(offsets_of(data, 0, &[]), (vec![0, 1, 3], 4));
+    }
+
+    #[test]
+    fn an_aborted_transaction_and_its_marker_are_dropped_and_the_offset_advances() {
+        let mut data = txn_batch(7, &[0, 1], None);
+        data.extend(txn_batch(7, &[2], Some(0)));
+        // The marker is the fetch's last batch: the next offset passes it.
+        assert_eq!(offsets_of(data.clone(), 0, &[(7, 0)]), (vec![], 3));
+        data.extend(encode_batch(&[3, 4]));
+        assert_eq!(offsets_of(data, 0, &[(7, 0)]), (vec![3, 4], 5));
+    }
+
+    /// Two producers interleaved: 7 aborts, 8 commits; then 7 starts a new
+    /// transaction after its abort marker, which is kept.
+    #[test]
+    fn only_the_aborted_producers_batches_inside_its_transaction_are_dropped() {
+        let mut data = txn_batch(7, &[0], None);
+        data.extend(txn_batch(8, &[1], None));
+        data.extend(txn_batch(7, &[2], None));
+        data.extend(txn_batch(7, &[3], Some(0)));
+        data.extend(txn_batch(8, &[4], Some(1)));
+        data.extend(txn_batch(7, &[5], None));
+        data.extend(txn_batch(7, &[6], Some(1)));
+        assert_eq!(offsets_of(data, 0, &[(7, 0)]), (vec![1, 5], 7));
+    }
+
+    /// An abort listed for a later range does not touch the batches before it.
+    #[test]
+    fn an_abort_starting_later_does_not_drop_earlier_batches() {
+        let mut data = txn_batch(7, &[0], None);
+        data.extend(txn_batch(7, &[1], Some(1)));
+        data.extend(txn_batch(7, &[2], None));
+        data.extend(txn_batch(7, &[3], Some(0)));
+        assert_eq!(offsets_of(data, 0, &[(7, 2)]), (vec![0], 4));
+    }
