# Logweir's build of the kafka-backup engine (OD-3, PROD-00.2). Read as text by
# scripts/engine-source.sh and by the tests; never sourced.
#
# ENGINE_VERSION is what `kafka-backup --version` prints for Logweir's build:
# <OSO release>+logweir.<n>. ENGINE_DIGEST is the build-input digest over the
# vendored tarball, the patch folder and ENGINE_VERSION
# (`scripts/engine-source.sh digest`). Any change to those inputs bumps <n> and
# re-records the digest: third_party/kafka-backup-patches/README.md.
ENGINE_VERSION=0.23.3+logweir.5
ENGINE_DIGEST=sha256:9ebf8c668541b8e03f3f8ac3f57beb5d20b92a4cb1e526e71eaf0c02b2c7bc15
