# deploy/poc/versions.env — every version the PoC profile installs, in one place.
# Sourced by the commands in deploy/poc/README.md and by deploy/poc/validate.sh.
# Change a line here and nowhere else; README.md records why each one is pinned.

# The Logweir release: the published Docker Hub images of one main commit
# (`sha-<commit>` tags from .github/workflows/images.yml) and the chart from the
# SAME commit of this repository. Digests as published, for the record:
#   weirkeeper       sha256:a6a03cb458aff27c7d276313afcb60b0278d5280015dea8032d76606e709339e
#   logweir          sha256:8c2250692e2b694a986d6fcdbbc6e270eca26ce7956e09451765a499f72f8899
#   logweir-console  sha256:8dc45f25a3f2132393c01e12521102de75e303f10072e4e14607b8fd92f289ff
#   logweir-ui       sha256:99afb09b630dc2772fc065b01b88a5733c0fde619f62ea1b27f41aaf2c915469
LOGWEIR_COMMIT=306cebf63adda5d6fd872674ffca5b2c05a2236c
LOGWEIR_TAG=sha-306cebf63adda5d6fd872674ffca5b2c05a2236c
# The previous published main commit, for the upgrade rehearsal (README, "Upgrade").
LOGWEIR_PREVIOUS_COMMIT=7b0277b85f04e2c915f011326932b4bac9239095
LOGWEIR_PREVIOUS_TAG=sha-7b0277b85f04e2c915f011326932b4bac9239095

# Upstream charts, pinned by chart version (each chart pins its own images by
# digest, or the values file here does).
INGRESS_NGINX_REPO=https://kubernetes.github.io/ingress-nginx
INGRESS_NGINX_CHART_VERSION=4.15.1   # controller v1.15.1
CERT_MANAGER_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.2   # cert-manager v1.21.2
DEX_REPO=https://charts.dexidp.io
DEX_CHART_VERSION=0.24.1             # dex v2.44.0

# Namespaces and hostnames. localtest.me and every subdomain resolve to
# 127.0.0.1 in public DNS; docker-desktop publishes the ingress controller's
# LoadBalancer Service on the host's 127.0.0.1:80/443.
LOGWEIR_NAMESPACE=logweir-system
POC_NAMESPACE=logweir-poc
INGRESS_NAMESPACE=ingress-nginx
CERT_MANAGER_NAMESPACE=cert-manager
DEX_NAMESPACE=dex
CONSOLE_HOST=logweir.localtest.me
DEX_HOST=dex.localtest.me
