# deploy/poc/versions.env — every version the PoC profile installs, in one place.
# Sourced by the commands in deploy/poc/README.md and by deploy/poc/validate.sh.
# Change a line here and nowhere else; README.md records why each one is pinned.

# ---------------------------------------------------------------- Logweir
# The release: the chart AND the four images of ONE `main` publication.
# images.yml publishes the images as `sha-<commit>` and, in the same run and
# after them, the chart as `oci://registry-1.docker.io/vladyslavhaina/
# logweir-chart --version 0.1.0-sha-<commit>`, whose image defaults are those
# same four tags (scripts/ci-images.sh `chart`).
#
# THIS PROFILE NEEDS A BUILD THAT CONTAINS THE CHART-GAP FIXES — the console's
# `oidc.caBundleFile` and `trustedProxyService`, the controller's `--probe` —
# which every `main` publication since `claude/chart-poc` (first: `86a554e6`,
# CI run 35957294926) carries. LOGWEIR_COMMIT names main `b748fd5f` (CI run
# 36100597420, 2026-09-25), the first publication with the fixes for the
# second PoC round's defects (P11, P12), the durable compromise revocation and
# the console's human-pass fixes; its four images and chart were pulled
# anonymously from Docker Hub before this pin, and the running PoC was upgraded
# to it from `02dc44b6` (itself upgraded from `86a554e6`) with README.md
# "Upgrade to a newer publication". A build older than `86a554e6`
# CANNOT stand in for it: its console refuses the configuration (exit 2,
# `unknown field`) and its controller fails the exec probes.
LOGWEIR_COMMIT=b748fd5f65e8bd7b4ea9755afbb7a983ccc7b3bf
LOGWEIR_TAG=sha-$LOGWEIR_COMMIT
LOGWEIR_CHART=oci://registry-1.docker.io/vladyslavhaina/logweir-chart
LOGWEIR_CHART_VERSION=0.1.0-sha-$LOGWEIR_COMMIT

# --------------------------------------------- upgrade rehearsal baselines
# docs/release-handoff.md plans two rehearsals from published builds to the
# release above (README.md, *Upgrade rehearsals*). Each installs with its OWN
# chart, taken from this repository at that commit (`git archive`), and its own
# values file under rehearsals/.
#   R1: the last version tag. No console image exists at v0.1.5.
R1_REF=v0.1.5
R1_COMMIT=9cc78a35251df7fcb820d92a62e4c327e8f3ad1a
R1_TAG=v0.1.5
#   R2: the last publication before PLAT-15.2/17.2/19.2 (ac00819) — the
#   lab-refresh-8 build; it crosses all ten release-note items.
R2_REF=f49849db035d01ff968df7472914f57fc6c2e988
R2_COMMIT=f49849db035d01ff968df7472914f57fc6c2e988
R2_TAG=sha-f49849db035d01ff968df7472914f57fc6c2e988

# ------------------------------------------------------ upstream charts
# Pinned by chart version; each chart's images are pinned by digest in its
# values file here (or by the chart itself).
TRAEFIK_REPO=https://traefik.github.io/charts
TRAEFIK_CHART_VERSION=41.6.0         # Traefik v3.7.13
CERT_MANAGER_REPO=https://charts.jetstack.io
CERT_MANAGER_CHART_VERSION=v1.21.2   # cert-manager v1.21.2
DEX_REPO=https://charts.dexidp.io
DEX_CHART_VERSION=0.24.1             # dex v2.44.0

# ------------------------------------------- namespaces, hosts, addresses
# localtest.me and every subdomain resolve to 127.0.0.1 in public DNS;
# docker-desktop publishes Traefik's LoadBalancer Service on the host's
# 127.0.0.1:80/443. DEX_CLUSTER_IP is the fixed ClusterIP dex.values.yaml gives
# Dex's own Service and logweir.values.yaml's `hostAliases` maps dex.localtest.me
# to, so the console's OIDC back-channel never crosses the shared ingress.
# PoC-only: production resolves its IdP through real DNS.
LOGWEIR_NAMESPACE=logweir-system
POC_NAMESPACE=logweir-poc
INGRESS_NAMESPACE=traefik
CERT_MANAGER_NAMESPACE=cert-manager
DEX_NAMESPACE=dex
CONSOLE_HOST=logweir.localtest.me
DEX_HOST=dex.localtest.me
DEX_CLUSTER_IP=10.96.0.81
